# --- Cursor / AI workspace (never commit) ---
.cursor/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Node (both backend/ and frontend/) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/cache
.yarn/install-state.gz

# --- Env files (keep .env.example) ---
.env
.env.local
.env.*.local
!.env.example

# --- Build / dist ---
dist/
build/
out/
.cache/

# --- Vite (frontend/) ---
frontend/.vite/
frontend/dist/
frontend/dist-ssr/

# --- Backend runtime / generated ---
backend/dist/
backend/uploads/
backend/logs/
*.pid
*.seed
*.pid.lock

# --- Test / coverage ---
coverage/
.nyc_output/
*.lcov

# --- TypeScript / lint caches (future-proofing) ---
*.tsbuildinfo
.eslintcache

# --- Misc ---
*.log
