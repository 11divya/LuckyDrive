# --- Server ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/luckydrive

# --- Auth ---
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- Payments ---
# 'mock' is the only supported provider in this scaffold.
# Future values: 'payfast' | 'yoco' | 'stripe'
PAYMENTS_PROVIDER=mock

# --- Email ---
# Leave SMTP_* unset to use the console provider — it prints email contents
# (including ticket token numbers) to the backend stdout. Set all four below
# to switch to real SMTP delivery (Gmail, SendGrid, SES, Mailgun, etc.).
EMAIL_FROM=LuckyDrive <no-reply@luckydrive.co.za>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
